FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home app \
    && mkdir -p /data \
    && chown app:app /data

COPY app.py database.py ./

ENV DATABASE_PATH=/data/database.db
EXPOSE 5000

USER app
CMD ["python", "app.py"]
